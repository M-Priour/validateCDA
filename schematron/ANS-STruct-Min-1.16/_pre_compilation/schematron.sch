   <rule fpi="RULC-1" context="//hl7:ClinicalDocument[hl7:typeId[@root = '2.16.840.1.113883.1.3'][@extension = 'POCD_HD000040']]/hl7:recordTarget[not(@nullFlavor)]/hl7:patientRole[hl7:patient]/hl7:patient[not(@nullFlavor)]/hl7:guardian/hl7:addr[not(hl7:streetAddressLine)]/hl7:precinct" id="d3396e160-false-d3682e0">
