   <rule fpi="RULC-1" context="//hl7:ClinicalDocument[hl7:typeId[@root = '2.16.840.1.113883.1.3'][@extension = 'POCD_HD000040']]/hl7:legalAuthenticator[hl7:signatureCode[@code = 'S']]/hl7:assignedEntity/hl7:addr[not(hl7:streetAddressLine)]/hl7:precinct" id="d9318e160-false-d9604e0">
